# --- Сервер Reality -------------------------------------------------------
# Публичный адрес сервера (IP или домен), который увидят клиенты.
VPN_HOST=203.0.113.10
VPN_PORT=443

# Ключевая пара Reality. Генерируется install.sh:
#   docker run --rm ghcr.io/xtls/xray-core:latest x25519
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=

# Чужой сайт, под TLS-соединение к которому маскируется VPN.
# Требования: настоящий сайт с TLS 1.3 + HTTP/2, географически близкий
# к серверу, не заблокированный в стране пользователя.
REALITY_SNI=www.microsoft.com
REALITY_DEST=www.microsoft.com:443

# Короткие идентификаторы (hex, чётная длина, до 16 символов), через запятую.
REALITY_SHORT_IDS=

# --- Гео-фильтр -----------------------------------------------------------
# Коды стран (ISO 3166-1 alpha-2), с IP которых разрешены подключения.
VPN_ALLOWED_COUNTRIES=ru

# --- Выдача ключей ботом --------------------------------------------------
# ID администраторов Telegram через запятую — кто может выдавать ключи.
VPN_ADMINS=
# Профиль маршрутизации по умолчанию для инструкций пользователю.
VPN_PROFILE=ru
# Команда, применяющая изменения users.json на сервере.
VPN_RELOAD_CMD=/opt/vpn/tools/apply.sh
