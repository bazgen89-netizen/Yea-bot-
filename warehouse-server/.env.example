# Скопируйте в .env и заполните перед первым запуском:
#   cp .env.example .env

# Пароль базы. Любая длинная случайная строка, например:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Порт, на котором сервер слушает снаружи
PORT=3000

# Регистрация новых организаций. Закройте (false) после того, как заведёте
# свою: иначе адрес сервера позволит любому создать у вас аккаунт.
ALLOW_REGISTRATION=true
