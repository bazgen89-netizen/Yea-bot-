# Вход по паролю на папку со складом.
#
# Внутри 3 271 настоящий телефон клиентов. Без пароля адрес открыт любому,
# кто его знает или угадает, а адрес попадает в историю браузера и в
# мессенджеры сам собой.
#
# Путь ниже — стандартный для Beget при логине waystea. Если панель ругнётся
# на 500-ю ошибку, значит путь другой: файловый менеджер показывает его
# сверху, подставьте оттуда.

AuthType Basic
AuthName "WAYSTEA"
AuthUserFile /home/w/waystea/waystea.ru/public_html/sklad/.htpasswd
Require valid-user

# Приёмник обновлений — единственное исключение.
#
# Он должен впускать ночную сборку, а пароля от этой папки у неё нет и быть
# не должно. Взамен у него своя защита, причём построже здешней: длинный
# случайный ключ заголовком, сверка без утечки по времени и одинаковая 404-я
# на любую ошибку. Отдавать наружу он не умеет вовсе — только принимать.
<Files "priem.php">
  Require all granted
  Satisfy Any
</Files>

# А черновик, пока программа едет, не должен отдаваться никому: это
# наполовину доехавший файл с телефонами клиентов.
<Files ".index.html.частями">
  Require all denied
</Files>

# В поиск программе попадать незачем.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

Options -Indexes
DirectoryIndex index.html

# Всегда спрашивать у сервера, не появилось ли новое.
#
# Без этого браузер решает сам, насколько долго считать файл свежим, и
# телефон Вазгена показывал вчерашнюю программу: ночное обновление до него
# просто не доходило. «no-cache» — это не «не хранить», а «хранить, но
# каждый раз переспрашивать»: если файл не менялся, сервер ответит 304 и
# двадцать шесть мегабайт заново не поедут.
<FilesMatch "\.(html|php)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
