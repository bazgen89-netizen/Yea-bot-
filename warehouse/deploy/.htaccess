# Вход по паролю на папку со складом.
#
# Внутри 3 271 настоящий телефон клиентов. Без пароля адрес открыт любому,
# кто его знает или угадает, а адрес попадает в историю браузера и в
# мессенджеры сам собой.
#
# Путь ниже — стандартный для Beget при логине waystea. Если панель ругнётся
# на 500-ю ошибку, значит путь другой: файловый менеджер показывает его
# сверху, подставьте оттуда.

AuthType Basic
AuthName "WAYSTEA"
AuthUserFile /home/w/waystea/waystea.ru/public_html/sklad/.htpasswd
Require valid-user

# В поиск программе попадать незачем.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

Options -Indexes
DirectoryIndex index.html
