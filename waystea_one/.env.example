BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://waystea:waystea@db:5432/waystea
OWNER_TELEGRAM_ID=
FIRST_REMINDER_MINUTES=30
SECOND_REMINDER_MINUTES=60
REMINDER_POLL_SECONDS=300
DAILY_REPORT_HOUR=21
DAILY_REPORT_MINUTE=0
ANTHROPIC_API_KEY=
# Optional: a dedicated "какой чай привезти" chat/topic (see
# app/handlers/tea_requests.py). Leave both empty to keep the feature off.
# TEA_REQUEST_THREAD_ID is only needed if it's a forum topic inside an
# existing group rather than its own chat.
TEA_REQUEST_CHAT_ID=
TEA_REQUEST_THREAD_ID=
# Maintenance switch. Set to 1 and restart to pause the bot: the health
# endpoint stays up (so Render keeps the service alive) but no tasks,
# reminders or reports go out. Unset and restart to resume.
BOT_PAUSED=
# Поиск живых вопросов покупателей в интернете (app/services/websearch.py).
# Тот же ключ Serper, что у чайного бота. Не задан — раз в неделю просто
# ничего не предлагается, остальное работает.
SERPER_KEY=
# Геометка, чай дня и викторина дополнительных переменных не требуют:
# координаты точек лежат в scripts/seed_stores.py, вопросы — в
# scripts/seed_quiz.py, окно викторины — QUIZ_WINDOW_* в app/main.py.
